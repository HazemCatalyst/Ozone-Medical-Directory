    function displayPhase(phase, phaseEn) {
      if (uiLang !== 'en') return phase;
      if (phaseEn) return phaseEn;
      const value = String(phase || '');
      const matched = value.match(/(?:المرحلة|phase)\s*([A-D])/i);
      if (matched) return `Phase ${matched[1].toUpperCase()}`;
      return value === 'غير محددة' ? 'Unspecified' : value;
