    function localizeStaticUI() {
      const skip = '#clinicsGrid, #categoryPillsContainer, #modalClinicName, #modalDoctorName, #modalPhaseBadge, #modalUnitBadge, #modalSpecialty, #modalTiming, #modalLocationHint, #modalPhonesList, #resultsCount, #showingStatus, #activeFiltersSummary, #dataSyncStatus, #ozoneLiveBadge, #toastNotification, script, style';
      const walker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT);
      let textNode;
      while ((textNode = walker.nextNode())) {
        if (!textNode.parentElement || textNode.parentElement.closest(skip)) continue;
        const content = textNode.nodeValue.trim();
        if (!content) continue;
        if (!originalUiTextNodes.has(textNode) && Object.prototype.hasOwnProperty.call(UI_STATIC_EN,content)) originalUiTextNodes.set(textNode, content);
      }
      originalUiTextNodes.forEach((ar,node) => {
        if (!node.isConnected) { originalUiTextNodes.delete(node); return; }
        const original = node.nodeValue;
        const old = original.trim();
        const chosen = lang(ar, UI_STATIC_EN[ar]);
        if (old !== chosen) node.nodeValue = original.replace(old, chosen);
      });
