        ['ozoneLiveBadge','title','حالة مزامنة الدليل','Directory sync status'],
        ['clearSearchBtn','title','مسح البحث','Clear search']
      ];
      for (const [id,attr,ar,en] of attrs) {
        const element = document.getElementById(id);
        if (element) element.setAttribute(attr,lang(ar,en));
      }
