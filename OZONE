    function normalizeSheetRecords(headers, rows) {
      if (!Array.isArray(headers) || !Array.isArray(rows)) throw new Error('صيغة بيانات الشيت غير معروفة');
      let currentHeaders = headers.map(cleanCell);
      let currentRows = rows;
      let indices = getHeaderIndices(currentHeaders);
      if (indices.name === undefined && rows.length && Array.isArray(rows[0])) {
        const candidate = rows[0].map(cleanCell);
        const possible = getHeaderIndices(candidate);
        if (possible.name !== undefined && Object.keys(possible).length >= 3) {
          indices = possible;
          currentHeaders = candidate;
          currentRows = rows.slice(1);
        }
      }
      // V9 requires the API to expose the six translated fields. Old V8 deployments
      // would otherwise show a connected badge without any English sheet values.
      if (!['phaseEn','nameEn','doctorEn','specialtyEn','timingEn','bookingEn']
            .every(field => indices[field] !== undefined)) {
        throw new Error('يلزم نشر كود Apps Script الثنائي اللغة V9 لاستقبال الأعمدة الإنجليزية I:N');
      }
      // Never assume an arbitrary column is the clinic name: wrong data is worse than the cached directory.
      if (indices.name === undefined || (indices.unit === undefined && indices.doctor === undefined)) {
        throw new Error('تعذّر تحديد أعمدة اسم العيادة ورقم الوحدة أو الطبيب من عناوين الشيت');
      }
      const get = (row, field) => indices[field] === undefined ? '' : cleanCell(row[indices[field]]);
      const seen = new Set();
      const output = currentRows.map((row, index) => {
        if (!Array.isArray(row)) return null;
        const name = get(row, 'name');
        const unit = get(row, 'unit').toUpperCase();
        const doctor = get(row, 'doctor');
        if (!name || (!unit && !doctor)) return null;
        const stableKey = unit || `${name}|${doctor}|${index}`;
        const duplicateKey = `${stableKey}|${name}|${doctor}`;
        if (seen.has(duplicateKey)) return null;
        seen.add(duplicateKey);
        const previous = fallbackByUnit.get(unit);
        const specialty = get(row, 'specialty');
        const category = get(row, 'category') ||
          (previous && specialty === previous.specialty ? previous.category : inferCategory(specialty));
        const rawPhone = get(row, 'rawPhone');
        const phones = phoneNumbers(rawPhone);
        return {
          id: previous ? previous.id : stableId(stableKey),
          num: get(row, 'num') || String(index + 1),
          phase: inferPhase(get(row, 'phase'), unit),
          name, doctor, specialty, category, unit,
          timing: get(row, 'timing') || 'المواعيد غير متاحة حاليًا',
          rawPhone: rawPhone || 'حجز مسبق',
          phaseEn: get(row,'phaseEn'), nameEn: get(row,'nameEn'),
          doctorEn: get(row,'doctorEn'), specialtyEn: get(row,'specialtyEn'),
          timingEn: get(row,'timingEn'), bookingEn: get(row,'bookingEn'),
          phones
        };
      }).filter(Boolean);
      if (!output.length) throw new Error('الشيت لا يحتوي على صفوف عيادات قابلة للعرض');
      return output;
    }
    function recordsFromResponse(payload) {
      if (payload && payload.ok !== false &&
          (Number(payload.gid) !== Number(OZONE_SHEET.gid) ||
           payload.spreadsheetId !== OZONE_SHEET.spreadsheetId)) {
        throw new Error('يجب تحديث Apps Script إلى كود التبويب 1001 ثم إعادة نشر نسخة جديدة');
      }
      if (!payload || payload.status === 'error' || payload.ok === false) {
        const message = payload && payload.errors && payload.errors[0] && payload.errors[0].detailed_message;
        throw new Error(message || payload?.error || 'Google Sheets لم يُرجع بيانات صالحة');
      }
      if (payload.table && Array.isArray(payload.table.rows)) {
        const headers = (payload.table.cols || []).map(col => col?.label || col?.id || '');
        const rows = payload.table.rows.map(row => (row.c || []).map(cell => {
          if (!cell) return '';
          return cleanCell(cell.f !== undefined ? cell.f : cell.v);
        }));
        return normalizeSheetRecords(headers, rows);
      }
      if (Array.isArray(payload.headers) && Array.isArray(payload.rows)) {
        return normalizeSheetRecords(payload.headers, payload.rows);
      }
      if (Array.isArray(payload.records) && payload.records.length) {
        const headers = Object.keys(payload.records[0]);
        return normalizeSheetRecords(headers, payload.records.map(record => headers.map(key => record[key])));
      }
      throw new Error('استجابة غير متوقعة من الشيت');
    }
    function updateSyncStatus() {
      const badge = document.getElementById('ozoneLiveBadge');
      if (badge) {
        if (sheetState.loading) {
          badge.textContent = lang('جارٍ الاتصال…','Connecting…');
          badge.className = 'inline-flex items-center px-2 py-0.5 rounded-full text-xs font-bold bg-slate-100 text-slate-700';
        } else if (sheetState.source === 'live') {
          badge.textContent = lang('متصل بالشيت','Sheet Connected');
          badge.className = 'inline-flex items-center px-2 py-0.5 rounded-full text-xs font-bold bg-emerald-100 text-emerald-800';
        } else {
          badge.textContent = lang('غير متصل بالشيت','Sheet Offline');
          badge.className = 'inline-flex items-center px-2 py-0.5 rounded-full text-xs font-bold bg-amber-100 text-amber-800';
        }
      }
      if (!syncStatusElement) return;
      if (sheetState.loading) {
        syncStatusElement.textContent = lang('جارٍ فحص تحديثات Google Sheets…','Checking Google Sheets updates…');
        syncStatusElement.className = 'text-xs font-bold text-slate-500';
      } else if (sheetState.source === 'live') {
        const time = sheetState.lastUpdated ? ` · ${new Date(sheetState.lastUpdated).toLocaleTimeString('en-GB-u-nu-latn', {hour:'2-digit',minute:'2-digit'})}` : '';
        syncStatusElement.textContent = `${lang('● متصل بشيت جوجل','● Connected to Google Sheets')}${time}`;
        syncStatusElement.className = 'text-xs font-bold text-emerald-700';
      } else {
        const cause = sheetState.error ? ` (${lang('السبب: ','Reason: ')}${sheetState.error.slice(0, 150)})` : '';
        syncStatusElement.textContent = `${lang('● تعذر تحميل بيانات الصفحة المطلوبة','● Could not load selected sheet data')}${cause}`;
        syncStatusElement.title = sheetState.error || lang('تأكد من صلاحيات الشيت ورابط الربط وأسماء الأعمدة','Check sheet permissions, deployment URL, and column headers');
        syncStatusElement.className = 'text-xs font-bold text-amber-700';
      }
      if (syncRefreshElement) syncRefreshElement.disabled = sheetState.loading;
    }
    function updateClinicCount() {
      if (heroClinicsCountElement) heroClinicsCountElement.textContent = ALL_CLINICS.length.toLocaleString('en-US-u-nu-latn');
      if (headerClinicCountElement) headerClinicCountElement.textContent = ALL_CLINICS.length.toLocaleString('en-US-u-nu-latn');
      const phaseCounter = document.getElementById('heroPhaseCount');
      const specialtyCounter = document.getElementById('heroSpecialtiesCount');
      if (phaseCounter) phaseCounter.textContent = new Set(ALL_CLINICS.map(c => c.phase).filter(Boolean)).size.toLocaleString('en-US-u-nu-latn');
      if (specialtyCounter) specialtyCounter.textContent = Number.isInteger(sheetState.specialtyCount) && sheetState.specialtyCount > 0 ? sheetState.specialtyCount.toLocaleString('en-US-u-nu-latn') : '—';
    }
    function applySheetData(clinics, source, specialtyCount = null) {
      sheetState.specialtyCount = Number.isInteger(specialtyCount) && specialtyCount > 0 ? specialtyCount : null;
      clinics = clinics.map(englishDigitsInClinic);
      ALL_CLINICS = clinics;
      sheetState.source = source;
      sheetState.lastUpdated = Date.now();
      sheetState.error = '';
      const categorySet = new Set(clinics.map(clinic => clinic.category).filter(Boolean));
      CATEGORIES = ['الكل', ...originalCategoryOrder.filter(x => x !== 'الكل' && categorySet.has(x)),
        ...[...categorySet].filter(x => !originalCategoryOrder.includes(x)).sort((a,b) => a.localeCompare(b,'ar'))];
      if (!CATEGORIES.includes(currentCategory)) currentCategory = 'الكل';
      renderCategoryPills();
      updateClinicCount();
      renderClinics();
    }
    function loadCachedSheet() {
      try {
        const cache = JSON.parse(localStorage.getItem('ozone_sheet_cache_gid1001_v9') || 'null');
        if (cache && Array.isArray(cache.clinics) && cache.clinics.length) {
          applySheetData(cache.clinics, 'cache', Number(cache.specialtyCount) || null);
        }
      } catch (e) { console.warn('Sheet cache unavailable', e); }
    }
    function finishSheetRequest(requestId, error) {
      if (requestId !== sheetRequestId) return;
      clearTimeout(sheetRequestTimeout);
      sheetRequestTimeout = null;
      if (sheetRequestScript) {
        sheetRequestScript.remove();
        sheetRequestScript = null;
      }
      sheetState.loading = false;
      if (error) {
        sheetState.error = cleanCell(error.message || error);
        sheetState.source = ALL_CLINICS.length ? 'cache' : 'none';
        console.warn('تعذّر تحديث الشيت:', sheetState.error);
      }
      updateSyncStatus();
    }
    function refreshGoogleSheet(manual = false) {
      if (sheetState.loading) return;
      sheetState.loading = true;
      updateSyncStatus();
      const requestId = ++sheetRequestId;
      const url = OZONE_SHEET.webAppUrl.trim()
        ? new URL(OZONE_SHEET.webAppUrl)
        : new URL(`https://docs.google.com/spreadsheets/d/${OZONE_SHEET.spreadsheetId}/gviz/tq`);
      if (OZONE_SHEET.webAppUrl.trim()) {
        url.searchParams.set('callback', 'ozoneSheetReceive');
      } else {
        url.searchParams.set('gid', OZONE_SHEET.gid);
        url.searchParams.set('headers', '1');
        url.searchParams.set('tqx', 'out:json;responseHandler:ozoneSheetReceive');
      }
      url.searchParams.set('_', Date.now().toString());
      window.ozoneSheetReceive = function(payload) {
        if (requestId !== sheetRequestId) return;
        try {
          const clinics = recordsFromResponse(payload);
          const statsValue = payload && payload.stats && payload.stats.specialties;
          const specialtyCount = statsValue != null && /^\d+$/.test(String(statsValue)) && Number(statsValue) > 0 ? Number(statsValue) : null;
          applySheetData(clinics, 'live', specialtyCount);
          try { localStorage.setItem('ozone_sheet_cache_gid1001_v9', JSON.stringify({savedAt:Date.now(), clinics, specialtyCount})); } catch (e) {}
          finishSheetRequest(requestId);
          if (manual) showToast(`تم تحديث بيانات ${clinics.length} عيادة من جوجل شيت`);
        } catch (error) {
          finishSheetRequest(requestId, error);
          if (manual) showToast('تعذّر تحميل بيانات التبويب 1001، راجع حالة الاتصال');
        }
      };
      sheetRequestScript = document.createElement('script');
      sheetRequestScript.async = true;
      sheetRequestScript.src = url.toString();
      sheetRequestScript.onerror = () => {
        finishSheetRequest(requestId, new Error('تعذّر تحميل استجابة جوجل؛ تحقق من الإتاحة العامة أو رابط Apps Script'));
        if (manual) showToast('تعذر الاتصال بشيت جوجل؛ راجع صلاحيات الوصول');
      };
      // Some Google access-denied/login responses load as scripts but never call the JSONP handler.
      sheetRequestScript.onload = () => {
        if (sheetState.loading && requestId === sheetRequestId) {
          finishSheetRequest(requestId, new Error('جوجل لم يُرجع بيانات قابلة للقراءة؛ قد يكون الشيت خاصًا أو الرابط غير منشور'));
          if (manual) showToast('لم يرجع الشيت بيانات؛ تحقق من المشاركة أو رابط Apps Script');
        }
      };
      sheetRequestTimeout = setTimeout(() => {
        finishSheetRequest(requestId, new Error('انتهت مهلة الاتصال'));
        if (manual) showToast('انتهت مهلة الاتصال بشيت جوجل');
      }, 15000);
      document.head.appendChild(sheetRequestScript);
    }
    updateClinicCount();
    loadCachedSheet();
    updateSyncStatus();
    if (syncRefreshElement) syncRefreshElement.addEventListener('click', () => refreshGoogleSheet(true));
    refreshGoogleSheet();
    setInterval(() => { if (!document.hidden) refreshGoogleSheet(); }, OZONE_SHEET.refreshEveryMs);
    document.addEventListener('visibilitychange', () => {
      if (!document.hidden && !sheetState.loading && (!sheetState.lastUpdated || Date.now() - sheetState.lastUpdated > OZONE_SHEET.refreshEveryMs)) refreshGoogleSheet();
    });
    // --- End Google Sheets integration ---

  
    const languageToggleButton = document.getElementById('languageToggleBtn');
    if (languageToggleButton) languageToggleButton.addEventListener('click', () => setUILanguage(uiLang === 'ar' ? 'en' : 'ar'));
    setUILanguage(uiLang);
</script>
