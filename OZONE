    // Bilingual content comes from I:N of the source spreadsheet, not automatic translation.
    function clinicField(clinic, key) {
      const enKey = {name:'nameEn', doctor:'doctorEn', specialty:'specialtyEn', timing:'timingEn', phase:'phaseEn', rawPhone:'bookingEn'}[key];
      return uiLang === 'en' && enKey && clinic[enKey] ? clinic[enKey] : (clinic[key] || '');
    }
    function bookingText(clinic) {
      if (uiLang !== 'en') return clinic.rawPhone || 'حجز مسبق';
      if (clinic.bookingEn) return clinic.bookingEn;
