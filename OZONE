    const UI_CATEGORY_EN = Object.freeze({"الكل": "All", "أسنان": "Dentistry", "علاج طبيعي وتغذية": "Physiotherapy & Nutrition", "جلدية وتجميل": "Dermatology & Aesthetics", "باطنة وقلب وكلى": "Internal Medicine, Cardiology & Nephrology", "أطفال": "Pediatrics", "مخ وأعصاب ونفسي": "Neurology & Psychiatry", "عيون": "Ophthalmology", "عظام ومفاصل وعلاج ألم": "Orthopedics & Pain Management", "نساء وتوليد": "Obstetrics & Gynecology", "جراحة ومسالك": "Surgery & Urology", "أشعة وتحاليل": "Radiology & Laboratory", "أنف وأذن وحنجرة": "ENT", "مراكز واستشارات عامة": "General Clinics & Consultations"});
    function lang(ar, en) { return uiLang === 'en' ? en : ar; }
