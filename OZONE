      const filtered = getFilteredClinics();
      
      // Update Counts
      resultsCount.textContent = `${filtered.length} ${lang('عيادة','clinics')}`;
      
      // Filter Summary text
      let summaries = [];
      if (currentPhase !== 'all') summaries.push(displayPhase(currentPhase));
      if (currentCategory !== 'الكل') summaries.push(displayCategory(currentCategory));
      if (onlyDirectPhone) summaries.push(lang('اتصال مباشر','Direct phone'));
      if (onlyFavorites) summaries.push(lang('المفضلة','Favorites'));
      activeFiltersSummary.textContent = summaries.length > 0 ? `(${summaries.join(' • ')})` : '';

      if (filtered.length === 0) {
        clinicsGrid.innerHTML = '';
        emptyState.classList.remove('hidden');
        const emptyTitle = emptyState.querySelector('h3');
        if (emptyTitle) emptyTitle.textContent = ALL_CLINICS.length
          ? lang('لم يتم العثور على عيادات مطابقة','No matching clinics found')
          : lang('في انتظار بيانات صفحة الشيت المختارة','Waiting for selected sheet tab');
        loadMoreContainer.classList.add('hidden');
        return;
      }

      emptyState.classList.add('hidden');

      const itemsToShow = filtered.slice(0, displayedCount);
      clinicsGrid.innerHTML = '';
      itemsToShow.forEach(c => {
        clinicsGrid.appendChild(createClinicCard(c));
      });

      // Load More button logic
      if (displayedCount < filtered.length) {
        loadMoreContainer.classList.remove('hidden');
        showingStatus.textContent = lang(`يتم عرض ${itemsToShow.length} من أصل ${filtered.length} عيادة مطابقة`,`Showing ${itemsToShow.length} of ${filtered.length} matching clinics`);
