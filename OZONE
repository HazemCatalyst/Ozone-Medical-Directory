    // Location Hint Formatter based on Unit Code
    function getUnitLocationHint(phase, unit, phaseEn) {
      let floorHint = lang('الدور غير محدد','Floor unspecified');
      const cleanUnit = unit.toUpperCase().trim();
      if (cleanUnit.startsWith('G') || cleanUnit.startsWith('AG') || cleanUnit.startsWith('BG') || cleanUnit.startsWith('CG') || cleanUnit.startsWith('DG')) {
        floorHint = lang('الدور الأرضي (Ground Floor)','Ground Floor');
      } else if (cleanUnit.includes('1') && !cleanUnit.includes('2') && !cleanUnit.includes('3')) {
        floorHint = lang('الدور الأول (First Floor)','First Floor');
      } else if (cleanUnit.includes('2')) {
        floorHint = lang('الدور الثاني (Second Floor)','Second Floor');
      } else if (cleanUnit.includes('3')) {
        floorHint = lang('الدور الثالث (Third Floor)','Third Floor');
      }
      return `${displayPhase(phase, phaseEn)} • ${floorHint} • ${lang('وحدة كود: ','Unit: ')}${unit}`;
    }

    // Phase Badge Colors
    function getPhaseBadgeStyle(phase) {
      if (phase.includes('A')) return 'bg-blue-100 text-blue-800 border-blue-200';
      if (phase.includes('B')) return 'bg-emerald-100 text-emerald-800 border-emerald-200';
      if (phase.includes('C')) return 'bg-amber-100 text-amber-800 border-amber-200';
      if (phase.includes('D')) return 'bg-purple-100 text-purple-800 border-purple-200';
      return 'bg-slate-100 text-slate-800 border-slate-200';
    }

    // Filter and Sort Clinics
    function getFilteredClinics() {
      const q = currentSearch.trim().toLowerCase();
      
      let list = ALL_CLINICS.filter(c => {
        // Phase Filter
        if (currentPhase !== 'all' && c.phase !== currentPhase) {
          return false;
        }

        // Category Filter
        if (currentCategory !== 'الكل' && c.category !== currentCategory) {
          return false;
        }

        // Phone Filter
        if (onlyDirectPhone && (!c.phones || c.phones.length === 0)) {
          return false;
        }

        // Favorites Filter
        if (onlyFavorites && !favorites.includes(c.id)) {
          return false;
        }

        // Search Query
        if (q) {
          const matchName = [c.name,c.nameEn].some(v => (v || '').toLowerCase().includes(q));
          const matchDoctor = [c.doctor,c.doctorEn].some(v => (v || '').toLowerCase().includes(q));
          const matchSpec = [c.specialty,c.specialtyEn].some(v => (v || '').toLowerCase().includes(q));
          const matchUnit = c.unit.toLowerCase().includes(q);
          const matchPhase = [c.phase,c.phaseEn].some(v => (v || '').toLowerCase().includes(q));
          const matchPhone = [c.rawPhone,c.bookingEn].some(v => (v || '').toLowerCase().includes(q));
          if (!matchName && !matchDoctor && !matchSpec && !matchUnit && !matchPhase && !matchPhone) {
            return false;
          }
        }

        return true;
      });

      // Sorting
      if (currentSort === 'name') {
        list.sort((a, b) => clinicField(a,'name').localeCompare(clinicField(b,'name'), uiLang === 'en' ? 'en' : 'ar'));
      } else if (currentSort === 'doctor') {
        list.sort((a, b) => clinicField(a,'doctor').localeCompare(clinicField(b,'doctor'), uiLang === 'en' ? 'en' : 'ar'));
      } else if (currentSort === 'unit') {
        list.sort((a, b) => a.unit.localeCompare(b.unit, 'ar', { numeric: true }));
      }

      return list;
